{
  "name": "chat-interaction-guard",
  "version": "0.1.0",
  "description": "Zero-dependency engine for versioned chat interactions: safe stale-button rewinds and back-navigation for WhatsApp, Telegram, Slack, and Messenger bots.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp.d.ts",
      "import": "./dist/whatsapp.js",
      "require": "./dist/whatsapp.cjs"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "import": "./dist/telegram.js",
      "require": "./dist/telegram.cjs"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "import": "./dist/slack.js",
      "require": "./dist/slack.cjs"
    },
    "./twilio": {
      "types": "./dist/twilio.d.ts",
      "import": "./dist/twilio.js",
      "require": "./dist/twilio.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "bin": {
    "chat-interaction-guard": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/whatsapp.ts src/telegram.ts src/slack.ts src/twilio.ts src/middleware.ts src/cli.ts --format esm,cjs --dts --sourcemap --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "playground": "npm run build && node ./dist/cli.js",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-business-api",
    "telegram",
    "slack",
    "messenger",
    "chatbot",
    "bot",
    "fsm",
    "state-machine",
    "conversational-ui",
    "interactive-buttons",
    "quick-reply"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
